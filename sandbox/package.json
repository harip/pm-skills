{
  "name": "lidar-room-studio-ios",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node test-runner.js",
    "test:fixture": "node test-fixture-runner.js",
    "test:launch": "node test-app-launch.js",
    "test:visual": "node test-app-visual-title.js",
    "dump:device": "bash scripts/dump-device-data.sh",
    "deploy:phone": "bash scripts/deploy-to-device.sh",
    "postinstall": "node scripts/patch-svg-web.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.9.3"
  },
  "private": true
}
